{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "komesa",
	"compatibility_date": "2025-04-02",
	"compatibility_flags": [
		"nodejs_compat",
		"nodejs_compat_populate_process_env",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "komesa"
		}
	],
	"hyperdrive": [
		{
			"binding": "HYPERDRIVE",
			"id": "333a6a7b9378432a946c7d3da44ba7c6",
		}
	]
	// Secrets (DATABASE_URL, JWT_SECRET) nastav přes: wrangler secret put DATABASE_URL
	// nebo v Cloudflare Dashboard → Workers → komesa → Settings → Variables
}